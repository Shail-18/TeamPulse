rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    match /leave_requests/{leaveId} {
      allow read, write: if request.auth != null;
    }
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }
    match /shoutouts/{shoutoutId} {
      allow read, write: if request.auth != null;
    }
    match /surveys/{surveyId} {
      allow read, write: if request.auth != null;
    }
    match /survey_responses/{responseId} {
      allow read, write: if request.auth != null;
    }
    match /performance_reviews/{reviewId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    match /team_metrics/{metricId} {
      allow read, write: if request.auth != null;
    }
    match /skill_catalog/{catalogId} {
      allow read, write: if request.auth != null;
    }
  }
}
